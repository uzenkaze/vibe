{
  "version": 2,
  "buildCommand": "node build_dist.js",
  "outputDirectory": "deploy_dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/learn/(.*)\\.(.*)", "destination": "/learn/$1.$2" },
    { "source": "/learn/(.*)", "destination": "/learn/index.html" },
    { "source": "/carrep/(.*)\\.(.*)", "destination": "/carrep/$1.$2" },
    { "source": "/carrep/(.*)", "destination": "/carrep/index.html" },
    { "source": "/asset/(.*)\\.(.*)", "destination": "/asset/$1.$2" },
    { "source": "/asset/(.*)", "destination": "/asset/index.html" },
    { "source": "/livetv/(.*)\\.(.*)", "destination": "/livetv/$1.$2" },
    { "source": "/livetv/(.*)", "destination": "/livetv/index.html" },
    { "source": "/task/(.*)\\.(.*)", "destination": "/task/$1.$2" },
    { "source": "/task/(.*)", "destination": "/task/task-manager.html" },
    { "source": "/hobby/(.*)\\.(.*)", "destination": "/hobby/$1.$2" },
    { "source": "/hobby/(.*)", "destination": "/hobby/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
