{
  "version": 2,
  "outputDirectory": "deploy_dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/:path*\\.(js|css|png|jpg|jpeg|gif|svg|ico|json|woff|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
