{
  "version": 2,
  "buildCommand": "node build_dist.js",
  "outputDirectory": "deploy_dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/learn/assets/:path*", "destination": "/learn/assets/:path*" },
    { "source": "/learn/:path*", "destination": "/learn/index.html" },
    { "source": "/carrep/assets/:path*", "destination": "/carrep/assets/:path*" },
    { "source": "/carrep/:path*", "destination": "/carrep/index.html" },
    { "source": "/asset/assets/:path*", "destination": "/asset/assets/:path*" },
    { "source": "/asset/:path*", "destination": "/asset/index.html" },
    { "source": "/livetv/assets/:path*", "destination": "/livetv/assets/:path*" },
    { "source": "/livetv/:path*", "destination": "/livetv/index.html" },
    { "source": "/task/:path*", "destination": "/task/task-manager.html" },
    { "source": "/hobby/:path*", "destination": "/hobby/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
