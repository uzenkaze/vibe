{
  "version": 2,
  "buildCommand": "node build_dist.js",
  "outputDirectory": "deploy_dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/learn/(?!assets/|docs/|favicon|data\\.json)(.*)", "dest": "/learn/index.html" },
    { "src": "/carrep/(?!assets/|avatars/|data/|favicon)(.*)", "dest": "/carrep/index.html" },
    { "src": "/asset/(?!assets/|avatars/|data/|favicon)(.*)", "dest": "/asset/index.html" },
    { "src": "/livetv/(?!src/|assets/|favicon|manifest)(.*)", "dest": "/livetv/index.html" },
    { "src": "/task/(?!backup/|favicon|manpower|queries|table)(.*)", "dest": "/task/task-manager.html" },
    { "src": "/hobby/(?!favicon|playlist)(.*)", "dest": "/hobby/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
