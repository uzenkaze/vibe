{
  "version": 2,
  "buildCommand": "node build_dist.js",
  "outputDirectory": "deploy_dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/learn/([^.]*)", "dest": "/learn/index.html" },
    { "src": "/carrep/([^.]*)", "dest": "/carrep/index.html" },
    { "src": "/asset/([^.]*)", "dest": "/asset/index.html" },
    { "src": "/livetv/([^.]*)", "dest": "/livetv/index.html" },
    { "src": "/task/([^.]*)", "dest": "/task/task-manager.html" },
    { "src": "/hobby/([^.]*)", "dest": "/hobby/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
